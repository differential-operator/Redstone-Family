{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/differential-operator/Redstone-Family/model-spec-v1",
  "title": "Redstone Family native entity model specification v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "target",
    "texture",
    "parts",
    "animation"
  ],
  "properties": {
    "schema_version": {
      "const": 1,
      "type": "integer"
    },
    "id": {
      "$ref": "#/$defs/resourceId"
    },
    "target": {
      "const": "native_entity",
      "type": "string"
    },
    "texture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "width",
        "height"
      ],
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\.png$"
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "parts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/part"
      }
    },
    "animation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "profile",
        "parameters"
      ],
      "properties": {
        "type": {
          "const": "procedural",
          "type": "string"
        },
        "profile": {
          "const": "vanilla_slime",
          "type": "string"
        },
        "parameters": {
          "type": "object",
          "additionalProperties": false
        }
      }
    }
  },
  "$defs": {
    "resourceId": {
      "type": "string",
      "pattern": "^redstonefamily:[a-z0-9_]+$"
    },
    "part": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "parent",
        "pivot",
        "rotation",
        "cubes"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "parent": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "pivot": {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "minItems": 3,
          "maxItems": 3
        },
        "rotation": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3
        },
        "cubes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/cube"
          }
        }
      }
    },
    "cube": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "origin",
        "size",
        "uv",
        "mirror"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "origin": {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "minItems": 3,
          "maxItems": 3
        },
        "size": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "uv": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "mirror": {
          "type": "boolean"
        }
      }
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "assets"
      ],
      "properties": {
        "schema_version": {
          "const": 1,
          "type": "integer"
        },
        "assets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/asset"
          }
        }
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "source",
        "source_sha256",
        "generator",
        "outputs",
        "inputs"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/resourceId"
        },
        "kind": {
          "type": "string",
          "enum": [
            "native_entity",
            "texture",
            "item_model",
            "structure"
          ]
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "source_sha256": {
          "$ref": "#/$defs/hash"
        },
        "generator": {
          "type": "string",
          "minLength": 1
        },
        "outputs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/output"
          }
        },
        "inputs": {
          "type": "array",
          "items": {
            "required": [
              "path",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "$ref": "#/$defs/hash"
              }
            },
            "type": "object",
            "additionalProperties": false
          }
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/hash"
        }
      }
    },
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
